<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Samsung Battery Stats"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check your battery information"
            android:textSize="14sp"
            android:textColor="#B0B0B0"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Battery data is extracted from system logs."
                    android:textSize="13sp"
                    android:textColor="#B0B0B0"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 How to Use"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1️⃣ Tap 'OPEN SYSDUMP' below, then type '#' at the end of *#9900 in the dialer"
                    android:textSize="14sp"
                    android:textColor="#E0E0E0"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2️⃣ In SysDump, select 'Run dumpstate/logcat', wait 2-3 minutes, then select 'OK'"
                    android:textSize="14sp"
                    android:textColor="#E0E0E0"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3️⃣ Select 'Copy to sdcard(include CP Ramdump)'"
                    android:textSize="14sp"
                    android:textColor="#E0E0E0"
                    android:layout_marginBottom="12dp"/>

                <ImageView
                    android:id="@+id/ivSysDumpInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sysdump_instructions"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="SysDump Screen"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4️⃣ Return here and tap 'READ BATTERY LOGS'"
                    android:textSize="14sp"
                    android:textColor="#E0E0E0"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Note: Auto Blocker must be turned OFF in Settings > Security and privacy for SysDump to work."
                    android:textSize="13sp"
                    android:textColor="#FFB74D"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenSysDump"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Open SysDump"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_primary"
            android:layout_marginBottom="12dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReadLogs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Read Battery Logs"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_secondary"
            android:layout_marginBottom="12dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteLogs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Delete Log Files"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_delete"
            android:layout_marginBottom="24dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="#BB86FC"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to read battery stats"
            android:textSize="14sp"
            android:textColor="#B0B0B0"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="visible"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Battery Statistics"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2C2C2C"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvFirstUseDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="First Use: --"
                    android:textSize="16sp"
                    android:textColor="#E0E0E0"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Battery Health"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#E0E0E0" />

                    <TextView
                        android:id="@+id/tvBatteryHealthInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ⓘ"
                        android:textSize="20sp"
                        android:textColor="#BB86FC"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBatteryHealthAsoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ASOC: --"
                    android:textSize="16sp"
                    android:textColor="#E0E0E0"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvBatteryHealthBsoh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BSOH: --"
                    android:textSize="16sp"
                    android:textColor="#E0E0E0"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvChargeCycles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Charge Cycles: --"
                    android:textSize="16sp"
                    android:textColor="#E0E0E0"
                    android:padding="8dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ This app only works on Samsung devices with SysDump access"
            android:textSize="12sp"
            android:textColor="#808080"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:padding="8dp"/>

    </LinearLayout>

</ScrollView>
